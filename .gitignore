# ===========================================================
# 敏感业务数据 —— 严禁入库
# ===========================================================
# 真实客户姓名(386 行) / 联通订单号(99 条): 客户隐私, 泄露即事故
名单.txt
订单号.txt
# 查询产物: MHTML 含姓名、手机号、证件号、地址
导出结果/*
!导出结果/.gitkeep
# 运行日志: 含完整查询轨迹
运行日志.log*
*.log.old
# 断点续跑状态
进度.txt

# ===========================================================
# 本地环境 —— 与个人机器绑定, 不应共享
# ===========================================================
# 真实配置(含标定坐标与本机绝对路径); 模板见 config.example.json
config.json
.workbuddy/
.venv/
venv/

# ===========================================================
# 常规忽略
# ===========================================================
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.idea/
.vscode/

# 图标中间产物(由 tools/make_icon.py 生成, 最终产物为 AppIcon.icns)
assets/AppIcon.iconset/

# ===========================================================
# py2app 构建产物(自包含 .app 体积大, 不入库; 构建脚本 setup.py/build_app.sh 入库)
# ===========================================================
dist/
build/
build*.log
