#!/bin/bash
# IBOS 批量查询助手 - .app 启动器
# 由 LaunchServices 调用, Dock 图标来自 Contents/Resources/AppIcon.icns
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
cd "$PROJECT_DIR"

# Python 探测顺序: Framework 构建(GUI 最佳) -> 项目 venv -> workbuddy venv -> 系统
PY=""
for candidate in \
  "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3" \
  "$PROJECT_DIR/.venv/bin/python" \
  "$HOME/.workbuddy/binaries/python/envs/ibos-scraper/bin/python" \
  "$(command -v python3 2>/dev/null)"; do
  if [ -x "$candidate" ]; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  osascript -e 'display notification "未找到 Python 运行环境" with title "IBOS查询助手"'
  exit 1
fi

# 静默补装依赖(仅首次)
"$PY" -c "import pyautogui, pyperclip" 2>/dev/null || \
  "$PY" -m pip install -q -r "$PROJECT_DIR/requirements.txt" 2>/dev/null

# 非 Framework Python 需手动指定 Tcl/Tk 库路径
PY_PREFIX="$("$PY" -c 'import sys; print(sys.prefix)' 2>/dev/null)"
for tcl_ver in tcl9.0 tcl8.6 tcl8.5; do
  if [ -d "$PY_PREFIX/lib/$tcl_ver" ]; then
    export TCL_LIBRARY="$PY_PREFIX/lib/$tcl_ver"
    break
  fi
done
for tk_ver in tk9.0 tk8.6 tk8.5; do
  if [ -d "$PY_PREFIX/lib/$tk_ver" ]; then
    export TK_LIBRARY="$PY_PREFIX/lib/$tk_ver"
    break
  fi
done

# exec: Python 成为 .app 进程本体, Dock/访达/切换器统一显示应用图标
exec "$PY" "$PROJECT_DIR/gui/app.py"
